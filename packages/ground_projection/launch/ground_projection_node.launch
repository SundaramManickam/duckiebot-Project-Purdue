<launch>
  <arg name="veh" doc="Name of vehicle. ex: megaman"/>
  <arg name="param_file_name" default="default" doc="Specify a param file. ex:megaman." />

  <arg name="pkg_name" value="ground_projection"/>
  <arg name="node_name" default="ground_projection_node"/>

  <group ns="$(arg veh)">
    <node name="$(arg node_name)"
          pkg="$(arg pkg_name)"
          type="$(arg node_name).py"
          output="screen">

      <rosparam command="load"
                file="$(find ground_projection)/config/$(arg node_name)/$(arg param_file_name).yaml"/>

      <!-- 🔴 Camera info to private "~camera_info" -->
      <remap from="~camera_info"
             to="camera_node/camera_info"/>

      <!-- 🔴 Feed projected segments input from line detector -->
      <remap from="~lineseglist_in"
             to="/$(arg veh)/line_detector_node/segment_list"/>
    </node>
  </group>
</launch>
