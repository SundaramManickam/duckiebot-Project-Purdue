<launch>
    <arg name="veh" doc="Name of vehicle. ex: dragon"/>
    <arg name="param_file_name" default="default" doc="Specify a param file"/>
    
    <arg name="pkg_name" value="anti_instagram"/>
    <arg name="node_name" default="anti_instagram_node"/>

    <group ns="$(arg veh)">
        <node name="$(arg node_name)" 
              pkg="$(arg pkg_name)" 
              type="$(arg node_name).py" 
              output="screen" 
              required="true">
            
            <rosparam command="load" 
                      file="$(find anti_instagram)/config/$(arg node_name)/$(arg param_file_name).yaml"/>

            <!-- 🔴 Camera input remapping -->
            <remap from="~uncorrected_image/compressed"
                   to="/dragon/camera_node/image/compressed"/>
        </node>
    </group>
</launch>
